{
  "name": "endfall",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Ebbfall: a browser real-time strategy game in the 1998 mold.",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "predev": "npm run build:wasm",
    "dev": "vite",
    "prebuild": "npm run build:wasm",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "sim": "npm run build:wasm && node scripts/headless.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.e2e.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "three": "^0.186.1",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  }
}
